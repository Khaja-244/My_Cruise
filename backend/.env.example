APP_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://cruise:cruise@localhost:5432/my_cruise
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail@gmail.com

STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase-service-account.json
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
CABIN_HOLD_MINUTES=10
TAX_RATE=0.00
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
ADMIN_EMAIL=admin@mycruise.com
ADMIN_INITIAL_PASSWORD=<set-a-strong-unique-password>

